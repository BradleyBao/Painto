<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Painto.PenControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Painto"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localcp="using:Painto.Modules"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="PenToolTemplate" x:DataType="localcp:PenData">
            <ItemContainer HorizontalAlignment="Center" Width="Auto" AutomationProperties.Name="{x:Bind penType}" ToolTipService.ToolTip="{x:Bind Name}">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{x:Bind Icon}" Foreground="{x:Bind PenColorString}"/>
            </ItemContainer>
        </DataTemplate>

        <Style x:Key="PenEditFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>
        </Style>

        <!--
            ShouldConstrainToRootBounds="False" is required here: the toolbar window this
            control lives in is tiny (just tall enough for the pen row), so a normal flyout
            would be squeezed into that window's bounds. Setting this makes the flyout render
            in its own top-level surface so it can float freely above the toolbar instead.
        -->
        <Flyout x:Name="PenEditFlyout" Placement="Top" ShouldConstrainToRootBounds="False"
                FlyoutPresenterStyle="{StaticResource PenEditFlyoutPresenterStyle}" Closed="PenEditFlyout_Closed">
            <local:PenEditFlyoutContent x:Name="PenEditContent" Applied="PenEditContent_Applied" Cancelled="PenEditContent_Cancelled"/>
        </Flyout>
    </UserControl.Resources>

    <GridView x:Name="PenItemList" IsItemClickEnabled="True"
              ScrollViewer.VerticalScrollBarVisibility="Hidden" CanDragItems="True" CanReorderItems="True"
              DoubleTapped="PenItemList_DoubleTapped" IsDoubleTapEnabled="True" AllowDrop="True" Tapped="PenItemList_ItemClick"
              Padding="0 3 0 0" Margin="0" ScrollViewer.VerticalScrollMode="Disabled" HorizontalAlignment="Center" 
              RightTapped="PenItemList_RightTapped"
              Background="{ThemeResource ControlStrokeColorOnAccentDefault}"
    ItemTemplate="{StaticResource PenToolTemplate}" ItemsSource="{x:Bind ItemsSource}">
        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Margin" Value="0, 0, 0, 0"/>
            </Style>
        </GridView.ItemContainerStyle>

    </GridView>


</UserControl>
